PORT=3000

# Number of reverse proxies / load balancers in front of the Gateway.
# Leave at 0 when clients connect directly, so the logged source IP cannot
# be spoofed with an X-Forwarded-For header.
TRUST_PROXY=0

# Where the Gateway forwards verified requests
BACKEND_URL=http://localhost:4000

# OIDC provider settings - fill these in after creating your tenant
# with any OIDC-compliant provider. See README.md for setup steps.
# Issuer and JWKS URI come from the provider's discovery document
# (/.well-known/openid-configuration): the "issuer" and "jwks_uri" fields.
OIDC_ISSUER=https://YOUR_IDP_DOMAIN/
OIDC_AUDIENCE=https://secure-api.example.com
OIDC_JWKS_URI=https://YOUR_IDP_DOMAIN/.well-known/jwks.json
